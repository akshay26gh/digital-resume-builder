SECRET_KEY=change-me-to-a-long-random-string

# Amazon RDS (pick one)
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@your-db.xxxx.ap-south-1.rds.amazonaws.com:5432/resumedb
# DATABASE_URL=mysql+pymysql://USER:PASSWORD@your-db.xxxx.ap-south-1.rds.amazonaws.com:3306/resumedb

# Amazon S3 (leave S3_BUCKET empty to store PDFs on local disk while developing)
S3_BUCKET=
AWS_REGION=ap-south-1
S3_PRESIGN_EXPIRY=300
# On EC2 attach an IAM role instead of setting AWS keys here.
